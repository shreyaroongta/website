---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Home" description="Shreya Roongta is an educator and emerging learning designer focused on curriculum, instructional design, and meaningful learning experiences.">
<section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">Learning Design & Technology</p><h1>Thoughtful learning begins with understanding people.</h1><p class="lede">I’m Shreya Roongta, an educator pursuing graduate study in Learning Design and Technology. I’m building on my classroom experience to create clear, meaningful learning experiences.</p><div class="button-row"><a class="button" href={withBase('about/')}>Learn about me</a><a class="button secondary" href={withBase('projects/')}>Explore projects</a></div></div><aside class="hero-note" aria-label="Professional focus"><span class="monogram" aria-hidden="true">SR</span><p>Learning Designer<br/>Educator<br/>Curriculum Developer</p></aside></div></section>
<section class="section shell" aria-labelledby="focus-heading"><div class="section-heading"><p class="eyebrow">Areas of focus</p><h2 id="focus-heading">Designing with purpose</h2></div><div class="three-grid"><article><span class="number">01</span><h3>Learning experiences</h3><p>Connecting learner needs, clear goals, and thoughtful design decisions.</p></article><article><span class="number">02</span><h3>Curriculum development</h3><p>Shaping content and resources into coherent, useful learning pathways.</p></article><article><span class="number">03</span><h3>Educational technology</h3><p>Exploring how technology can support access, engagement, and understanding.</p></article></div></section>
<section class="section tint"><div class="shell selected-grid"><div><p class="eyebrow">Selected work</p><h2>A portfolio designed to grow</h2></div><div><p>Selected case studies and learning-design projects will be added throughout my MSLDT journey. Each will document the challenge, process, solution, and reflection behind the work.</p><a class="text-link" href={withBase('projects/')}>Visit the project collection <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
