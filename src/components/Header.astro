---
import { withBase } from '../lib/paths';
const pathname = Astro.url.pathname;
const links = [{href:'',label:'Home'},{href:'about/',label:'About'},{href:'projects/',label:'Projects'},{href:'resume/',label:'Resume'},{href:'contact/',label:'Contact'}];
const active = (href:string) => href === '' ? pathname === withBase('') : pathname.startsWith(withBase(href));
---
<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="nav-wrap shell">
    <a class="brand" href={withBase('')} aria-label="Shreya Roongta, home"><span aria-hidden="true">SR</span><strong>Shreya Roongta</strong></a>
    <nav aria-label="Primary navigation"><ul>{links.map(link => <li><a href={withBase(link.href)} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
  </div>
</header>
